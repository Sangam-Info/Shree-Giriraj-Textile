rules_version = '2';

// =====================================================================
// Shri Giriraj Textile — Jobwork System · Firestore security rules
// Roles are assigned by SIGN-IN EMAIL (see isAdmin/isSupervisor below) and must
// match __APP_USERS in public/js/firebase-config.js:
//   admin      — full access, including accounting & packaging
//   supervisor — gate entry, niwar gate entry & packaging only (NO accounting)
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Roles are assigned by sign-in email. Keep this list in step with
    // __APP_USERS in public/js/firebase-config.js. Only these addresses get
    // access; any other signed-in account is denied by the default rule below.
    function em()           { return signedIn() ? request.auth.token.email.lower() : ''; }
    function isAdmin()      { return em() == 'admin@gmail.com'; }
    function isSupervisor() { return em() == 'superwiser@gmail.com'; }
    function isStaff()      { return isAdmin() || isSupervisor(); }

    // --- identity & settings ---------------------------------------
    match /users/{uid} {
      allow read:  if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();                 // only the owner manages accounts
    }
    match /meta/{doc} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    // --- gate entry + packaging (both roles) -----------------------
    match /sheets/{id}       { allow read, write: if isStaff(); }   // job work sheet — source of truth
    match /packing/{id}      { allow read, write: if isStaff(); }   // independent packing lists
    match /niwarSheets/{id}  { allow read, write: if isStaff(); }   // niwar gate entry (weights only)

    // --- directories (staff read, admin manage) --------------------
    match /workers/{id}       { allow read: if isStaff(); allow write: if isAdmin(); }
    match /niwarParties/{id}  { allow read: if isStaff(); allow write: if isAdmin(); }

    // --- accounting (admin only — supervisor has none) -------------
    match /bills/{id}                     { allow read, write: if isAdmin(); }
    match /niwarParams/{id}               { allow read, write: if isAdmin(); }
    match /loans/{wid}/{document=**}      { allow read, write: if isAdmin(); }
    match /upad/{wid}/{document=**}       { allow read, write: if isAdmin(); }
    match /niwarUpad/{pid}/{document=**}  { allow read, write: if isAdmin(); }
    match /niwarLoans/{pid}/{document=**} { allow read, write: if isAdmin(); }

    // --- default deny ----------------------------------------------
    match /{document=**} { allow read, write: if false; }
  }
}
