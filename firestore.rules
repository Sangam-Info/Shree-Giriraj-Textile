rules_version = '2';

// =====================================================================
// Shri Giriraj Textile — Jobwork System · Firestore security rules
//
// Roles + per-module permissions are read from each account's own
//   users/{uid} = { role:"admin"|"supervisor", active:true, name:"…",
//                   email:"…", perms:{ gate:true, billing:false, … } }
//
//   admin       — full access to everything (perms ignored).
//   supervisor  — access ONLY to the modules the Owner switched ON in
//                 their perms map (User Management → Access toggles).
//
// The Owner can grant or revoke any module per user; access is enforced
// here at the database, not only in the UI.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasRole()  { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function userDoc()  { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role()     { return userDoc().role; }
    function active()   { return userDoc().active != false; }
    function isAdmin()  { return hasRole() && active() && role() == 'admin'; }
    function isStaff()  { return hasRole() && active() && (role() == 'admin' || role() == 'supervisor'); }

    // A module is permitted when the user is admin, or an active user whose
    // perms map grants it. Missing perms map / missing key => denied.
    function has(m) {
      return isAdmin() || (isStaff() && userDoc().get('perms', {}).get(m, false) == true);
    }

    // --- identity & settings ---------------------------------------
    match /users/{uid} {
      allow read:  if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();                 // only the Owner manages accounts & perms
    }
    match /meta/{doc} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    // --- gate job work sheet (source of truth) ---------------------
    // read by gate + the modules that derive from it; written by gate.
    match /sheets/{id} {
      allow read:  if has('gate') || has('ledger') || has('billing') || has('yearend') || has('upad');
      allow write: if has('gate');
    }

    // --- packaging --------------------------------------------------
    match /packing/{id} { allow read, write: if has('packing'); }

    // --- niwar jobwork (gate entry + its own accounting) -----------
    match /niwarSheets/{id}           { allow read, write: if has('niwar'); }
    match /niwarParties/{id}          { allow read, write: if has('niwar'); }
    match /niwarParams/{id}           { allow read, write: if has('niwar'); }
    match /niwarUpad/{pid}/{document=**}  { allow read, write: if has('niwar'); }
    match /niwarLoans/{pid}/{document=**} { allow read, write: if has('niwar'); }

    // --- job-worker directory (names) ------------------------------
    // readable by any active staff (every module resolves worker names);
    // written only by the Job Workers module.
    match /workers/{id} {
      allow read:  if isStaff();
      allow write: if has('workers');
    }

    // --- textile accounting ----------------------------------------
    match /bills/{id} {
      allow read:  if has('billing') || has('ledger') || has('yearend');
      allow write: if has('billing');
    }
    match /loans/{wid}/{document=**} {
      allow read:  if has('loans') || has('yearend');
      allow write: if has('loans');
    }
    match /upad/{wid}/{document=**} {
      allow read:  if has('upad') || has('yearend') || has('billing');
      allow write: if has('upad');
    }

    // --- default deny ----------------------------------------------
    match /{document=**} { allow read, write: if false; }
  }
}
